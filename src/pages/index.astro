        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
      }

      .about-matrix {
        display: grid;
        gap: 16px;
      }

      .signal-panel {
        overflow: hidden;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background: var(--surface-container-lowest);
      }

      .signal-row {
        display: grid;
        gap: 8px;
        border-top: 1px solid var(--outline-variant);
