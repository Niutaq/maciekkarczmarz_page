      .terminal-line {
        display: flex;
        gap: 10px;
        min-height: 24px;
        align-items: flex-start;
        color: var(--on-surface);
        overflow-wrap: anywhere;
      }

      .terminal-line span {
        color: var(--primary);
      }

      .infra-stack {
        position: relative;
        min-height: 240px;
        margin-top: 8px;
      }

      .infra-stack::before,
      .infra-stack::after {
        content: "";
        position: absolute;
        left: 26%;
        right: 22%;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 183, 121, 0.52),
          transparent
        );
        box-shadow: var(--glow-amber);
      }

      .infra-stack::before {
        top: 84px;
      }

      .infra-stack::after {
        top: 156px;
      }

      .stack-plate {
        position: absolute;
        display: grid;
        min-height: 88px;
        align-content: center;
        border: 1px solid rgba(205, 127, 50, 0.34);
        border-radius: var(--radius-default);
        padding: 16px;
        background:
          linear-gradient(
            145deg,
            rgba(205, 127, 50, 0.18),
            rgba(29, 27, 26, 0.92) 44%,
            rgba(15, 14, 13, 0.96)
          ),
          var(--surface-container);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.07),
          0 0 26px rgba(205, 127, 50, 0.08);
        transform: translate3d(0, 0, 0);
      }

      .stack-plate::before,
      .stack-plate::after {
        content: "";
        position: absolute;
        pointer-events: none;
        background: rgba(205, 127, 50, 0.18);
      }

      .stack-plate::before {
        left: 10px;
        right: 10px;
        top: 8px;
        height: 1px;
      }

      .stack-plate::after {
        top: 10px;
        bottom: 10px;
        right: 8px;
        width: 1px;
      }

      .stack-plate b {
        color: var(--on-surface);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 700;
      }

      .stack-plate span {
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        text-transform: uppercase;
      }

      .plate-a {
        top: 4px;
        left: 20px;
        width: 64%;
      }

      .plate-b {
        top: 72px;
        right: 8px;
        width: 64%;
      }

      .plate-c {
        top: 144px;
        left: 48px;
        width: 64%;
      }

      .section-grid {
        display: grid;
        gap: 24px;
      }

      .value-grid {
        display: grid;
        gap: 16px;
      }

      .card,
      .project-card,
      .timeline-card,
      .contact-panel,
      .stack-map,
      .skill-card {
        position: relative;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background:
          linear-gradient(
            145deg,
            rgba(29, 27, 26, 0.98),
            rgba(20, 19, 18, 0.98)
          ),
          var(--surface-container-low);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
      }

      html[data-theme="light"] .card,
      html[data-theme="light"] .project-card,
      html[data-theme="light"] .timeline-card,
      html[data-theme="light"] .contact-panel,
      html[data-theme="light"] .stack-map,
      html[data-theme="light"] .skill-card {
        background: var(--surface-container-low);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 1),
          0 0 0 1px rgba(0, 0, 0, 0.05);
      }

      .card::before,
      .project-card::before,
      .timeline-card::before,
      .skill-card::before,
      .contact-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: inherit;
        background:
          linear-gradient(90deg, rgba(255, 255, 255, 0.045), transparent 28%),
          linear-gradient(180deg, rgba(255, 183, 121, 0.04), transparent 34%);
      }

      .corner-cuts {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .corner-cuts::before,
      .corner-cuts::after {
        content: "";
        position: absolute;
        width: 24px;
        height: 24px;
        border-color: rgba(255, 183, 121, 0.54);
      }

      .corner-cuts::before {
        top: 12px;
        left: 12px;
        border-top: 1px solid;
        border-left: 1px solid;
        border-top-left-radius: 4px;
      }

      .corner-cuts::after {
        right: 12px;
        bottom: 12px;
        border-right: 1px solid;
        border-bottom: 1px solid;
        border-bottom-right-radius: 4px;
      }

      .card {
        overflow: hidden;
        padding: 24px;
      }

      .card h3 {
        margin-top: 16px;
      }

      .card p {
        margin-top: 12px;
        color: var(--on-surface-variant);
      }

      .card-index {
