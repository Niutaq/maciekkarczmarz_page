        box-shadow: var(--glow-amber);
      }

      .stack-map {
        overflow: hidden;
        min-height: 520px;
        padding: 24px;
      }

      .stack-map h3 {
        position: relative;
        z-index: 1;
      }

      .stack-map p {
        position: relative;
        z-index: 1;
        margin-top: 12px;
        color: var(--on-surface-variant);
      }

      .iso-stage {
        position: relative;
        min-height: 360px;
        margin-top: 24px;
        perspective: 900px;
      }

      .iso-grid {
        position: absolute;
        inset: 28px 0 0 0;
        transform: rotateX(54deg) rotateZ(-24deg);
        transform-origin: center;
        border: 1px solid var(--outline-variant);
        background:
          linear-gradient(rgba(255, 183, 121, 0.08) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(255, 183, 121, 0.08) 1px,
            transparent 1px
          ),
          rgba(15, 14, 13, 0.4);
        background-size: 32px 32px;
      }

      .iso-node {
        position: absolute;
        display: grid;
        min-width: 136px;
        min-height: 72px;
        align-content: center;
        border: 1px solid rgba(205, 127, 50, 0.52);
        border-radius: var(--radius-default);
        padding: 12px;
        background:
          linear-gradient(
            145deg,
            rgba(205, 127, 50, 0.18),
            rgba(29, 27, 26, 0.94)
          ),
          var(--surface-container);
        box-shadow:
          0 0 20px rgba(205, 127, 50, 0.1),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        transform: translateZ(0);
      }

      .iso-node span {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .iso-node b {
        color: var(--on-surface);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }

      .node-1 {
        top: 24px;
        left: 0;
      }

      .node-2 {
        top: 120px;
        right: 8px;
      }

      .node-3 {
        bottom: 48px;
        left: 24px;
      }

      .node-4 {
        bottom: 0;
        right: 32px;
      }

      .iso-link {
        position: absolute;
        height: 1px;
        background: linear-gradient(
          90deg,
          rgba(255, 183, 121, 0),
          rgba(255, 183, 121, 0.62),
          rgba(255, 183, 121, 0)
        );
        transform-origin: left center;
        box-shadow: var(--glow-amber);
      }

      .link-1 {
        top: 96px;
        left: 120px;
        width: 44%;
        transform: rotate(17deg);
      }

      .link-2 {
        top: 184px;
        left: 28%;
        width: 44%;
        transform: rotate(-23deg);
      }

      .link-3 {
        bottom: 86px;
        left: 164px;
        width: 38%;
        transform: rotate(10deg);
      }

      .project-grid {
        position: relative;
        display: grid;
        gap: 24px;
      }

      .project-grid::before {
        content: "";
        position: absolute;
        top: 16px;
        bottom: 16px;
        left: 10px;
        width: 1px;
        background: linear-gradient(
          180deg,
          transparent,
          rgba(255, 183, 121, 0.46),
          transparent
        );
      }

      .project-card {
        --rx: 0deg;
        --ry: 0deg;
        --mx: 50%;
        --my: 50%;
        overflow: hidden;
        display: grid;
        isolation: isolate;
        margin-left: 20px;
        transition:
          transform 220ms var(--ease-premium),
          border-color 220ms var(--ease-premium),
          box-shadow 220ms var(--ease-premium);
        transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry))
          translateY(0);
      }

      .project-card::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(
          circle at var(--mx) var(--my),
          rgba(255, 183, 121, 0.16),
          transparent 34%
        );
        transition: opacity 180ms var(--ease-premium);
      }

      .project-card:hover {
        border-color: var(--primary-container);
        box-shadow:
          0 0 28px rgba(205, 127, 50, 0.14),
          inset 0 1px 0 rgba(255, 255, 255, 0.07);
      }

      .project-card:hover::after {
        opacity: 1;
      }

      .project-media {
        position: relative;
        overflow: hidden;
        min-height: 224px;
        border-bottom: 1px solid var(--outline-variant);
        background:
          linear-gradient(
            135deg,
            rgba(255, 183, 121, 0.07),
            rgba(15, 14, 13, 0.1)
          ),
          var(--surface-container-lowest);
      }

      .project-media img {
        width: 100%;
        height: 100%;
        min-height: 224px;
        object-fit: contain;
        padding: 24px;
        opacity: 0.88;
        filter: saturate(0.85) contrast(1.08);
        transition:
          transform 600ms var(--ease-premium),
          opacity 220ms var(--ease-premium);
      }

      .project-card:hover .project-media img {
        transform: scale(1.035);
        opacity: 1;
      }

      .project-media::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(180deg, transparent, rgba(15, 14, 13, 0.28)),
          linear-gradient(90deg, rgba(205, 127, 50, 0.12), transparent 42%);
      }

      .project-content {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 20px;
        padding: 24px;
      }

      .project-top {
        display: grid;
        gap: 8px;
      }

      .project-top h3 {
        font-size: 1.5rem;
      }

      .project-summary {
        color: var(--on-surface-variant);
      }

      .project-facts {
        display: grid;
        gap: 12px;
      }

      .fact {
        border-left: 2px solid rgba(205, 127, 50, 0.64);
        padding-left: 12px;
      }

      .fact dt {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .fact dd {
        margin: 4px 0 0;
        color: var(--on-surface);
        font-size: 0.9375rem;
      }

      .project-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-top: 1px solid var(--outline-variant);
        padding-top: 20px;
      }

      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .project-link {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .project-link svg {
        width: 16px;
        height: 16px;
        transition: transform 180ms var(--ease-premium);
      }

      .project-link:hover svg {
        transform: translate(2px, -2px);
      }

      .dossier-layout {
        display: grid;
        gap: 24px;
      }

      .timeline-card {
        overflow: hidden;
        padding: 24px;
        height: auto;
        display: flex;
        flex-direction: column;
      }

      .timeline-card p:last-of-type {
        flex-grow: 1;
      }

      .timeline-card + .timeline-card {
        margin-top: 16px;
      }

      .timeline-date {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid rgba(205, 127, 50, 0.38);
        border-radius: var(--radius-default);
        padding: 6px 10px;
        color: var(--primary);
        background: rgba(205, 127, 50, 0.08);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .timeline-card h3 {
        margin-top: 16px;
      }

      .timeline-company {
        margin-top: 8px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }

      .timeline-card p {
        margin-top: 16px;
        color: var(--on-surface-variant);
      }

      .timeline-card .chip-row,
      .timeline-card .button {
        margin-top: 16px;
      }

      .contact-panel {
        overflow: hidden;
        display: grid;
        gap: 32px;
        padding: 24px;
      }

      .contact-copy {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 16px;
      }

      .contact-copy h2 {
        max-width: 680px;
      }

      .contact-links {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 8px;
        margin-top: 8px;
      }

      .contact-link {
        display: grid;
        gap: 4px;
        border-top: 1px solid var(--outline-variant);
        padding-block: 16px;
      }

      .contact-link span {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .contact-link strong {
        color: var(--on-surface);
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      .contact-form {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 24px;
      }

      .field {
        position: relative;
      }

      .field input,
      .field textarea {
        width: 100%;
        border: 0;
        border-bottom: 2px solid var(--outline-variant);
        border-radius: var(--radius-default) var(--radius-default) 0 0;
        color: var(--on-surface);
        background: rgba(15, 14, 13, 0.72);
        padding: 24px 12px 10px;
        outline: 0;
        transition:
          border-color 180ms var(--ease-premium),
          background-color 180ms var(--ease-premium),
          box-shadow 180ms var(--ease-premium);
      }

      .field textarea {
        min-height: 136px;
        resize: vertical;
      }

      .field label {
        position: absolute;
        left: 12px;
        top: 18px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        transform-origin: left top;
        transition:
          transform 180ms var(--ease-premium),
          color 180ms var(--ease-premium);
      }

      .field input:focus,
      .field textarea:focus {
        border-bottom-color: var(--primary);
        background: rgba(29, 27, 26, 0.9);
        box-shadow: 0 8px 20px rgba(205, 127, 50, 0.08);
      }

      html[data-theme="light"] .field input:focus,
      html[data-theme="light"] .field textarea:focus {
        background: rgba(255, 250, 244, 0.94);
      }

      .field input:focus + label,
      .field input:not(:placeholder-shown) + label,
      .field textarea:focus + label,
      .field textarea:not(:placeholder-shown) + label {
        color: var(--primary);
        transform: translateY(-12px) scale(0.82);
      }

      .site-footer {
        border-top: 1px solid var(--outline-variant);
        padding-block: 32px;
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .footer-links a {
        min-height: 32px;
        color: var(--on-surface-variant);
      }

      .footer-links a:hover {
        color: var(--primary);
      }

      .reveal {
        opacity: 1;
        transform: none;
      }

      .js .reveal {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 520ms var(--ease-premium),
          transform 520ms var(--ease-premium);
      }

      .js .reveal.is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      @media (min-width: 600px) {
        :root {
          --page-padding: 24px;
          --section-gap: 96px;
        }

        h1 {
          font-size: 4rem;
        }

        h2 {
          font-size: 2.5rem;
        }

        .wordmark-text,
        .menu-toggle-label,
        .nav-cta {
          display: inline-flex;
        }

        .console-grid,
        .value-grid,
        .skills-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .project-content,
        .timeline-card,
        .contact-panel,
        .card,
        .skill-card,
        .stack-map {
          padding: 32px;
        }
      }

      @media (max-width: 599px) {
        .lang-option {
          min-width: 36px;
          min-height: 40px;
        }

        .project-media {
          max-height: 260px;
        }

        .project-media img {
          height: auto;
          min-height: 0;
        }

        .iso-stage {
          min-height: 480px; /* Increase height for vertical spacing */
        }

        .iso-node {
          min-width: 120px;
          padding: 10px;
        }

        .node-1 {
          top: 0;
          left: 0;
        }

        .node-2 {
          top: 110px;
          right: 0;
        }

        .node-3 {
          top: 220px;
          left: 0;
        }

        .node-4 {
          top: 330px;
          right: 0;
        }

        .iso-link {
          display: none; /* Hide confusing links on mobile */
        }
      }

      @media (min-width: 960px) {
        :root {
          --page-padding: 64px;
          --section-gap: 120px;
        }

        h1 {
          font-size: 5rem;
        }

        h2 {
          font-size: 3rem;
        }

        .menu-toggle {
          display: none;
        }

        .nav-panel {
          position: static;
          display: block;
          border: 0;
          background: transparent;
          box-shadow: none;
        }

        .nav-links {
          display: flex;
          align-items: center;
          gap: 4px;
          padding: 0;
        }

        .nav-link {
          padding-inline: 10px;
        }

        .hero-layout {
          grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
          align-items: center;
        }

        .hero-mesh {
          transform: translate3d(
            calc(var(--px) * 12px),
            calc(var(--py) * 10px),
            0
          );
        }

        .hero-visual {
          transform: translate3d(
            calc(var(--px) * -14px),
            calc(var(--py) * -11px),
            0
          );
        }

        .about-matrix,
        .skills-layout,
        .dossier-layout {
          grid-template-columns: 0.82fr 1.18fr;
          align-items: start;
        }

        .dossier-layout {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          align-items: start;
        }

        .project-card {
          grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        }

        .project-media {
          min-height: 100%;
          border-right: 1px solid var(--outline-variant);
          border-bottom: 0;
        }

        .project-media img {
          height: 100%;
          min-height: 420px;
        }

        .project-facts {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fact-wide {
          grid-column: 1 / -1;
        }

        .footer-inner {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }
      }

      @media (min-width: 1200px) {
        h1 {
          font-size: 5.75rem;
        }

        .project-grid {
          gap: 32px;
        }
      }

      @media (hover: hover) and (pointer: fine) {
        .project-card:hover {
          transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry))
            translateY(-4px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.001ms !important;
        }

        .js .reveal {
          opacity: 1;
          transform: none;
        }
        .hero-mesh,
        .hero-visual,
        .project-card {
          transform: none !important;
        }

        .hero .floating {
          animation: none !important;
        }

        .hero-cursor {
          display: none !important;
        }

        html.hero-cursor-active,
        html.hero-cursor-active body,
        html.hero-cursor-active * {
          cursor: auto !important;
        }
      }

      .map-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
        border-bottom: 1px solid rgba(83, 68, 56, 0.72);
        padding-bottom: 12px;
      }

      html[data-theme="light"] .map-tabs {
        border-bottom-color: var(--outline-variant);
      }

      .map-tab {
        background: transparent;
        border: none;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 8px 16px;
        border-radius: var(--radius-default);
        cursor: pointer;
        transition: all 180ms var(--ease-premium);
      }

      .map-tab:hover {
        color: var(--primary);
        background: rgba(205, 127, 50, 0.08);
      }

      .map-tab.active {
        color: var(--primary);
        background: rgba(205, 127, 50, 0.12);
        box-shadow: inset 0 1px 0 rgba(255, 237, 223, 0.1);
      }

      html[data-theme="light"] .map-tab.active {
        background: rgba(196, 107, 0, 0.08);
        box-shadow: none;
      }

      .map-panel {
        display: none;
      }

      .map-panel.active {
        display: block;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0) rotate(0);
        }
        50% {
          transform: translateY(-10px) rotate(1deg);
        }
      }

      @keyframes wave {
        0% {
          border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }
        50% {
          border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
        }
        100% {
          border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }
      }

      .floating {
        animation: float 6s ease-in-out infinite;
      }

      .section {
        transition: background-color 1.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .card,
      .project-card,
      .skill-card,
      .timeline-card {
        transition:
          transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
          box-shadow 0.6s ease,
          background-color 0.8s ease;
      }

      /* Dreamy reveal effect */
      .js .reveal {
        opacity: 0;
        filter: blur(10px);
        transform: translate3d(0, 40px, 0) scale(0.98);
        transition:
          opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
          filter 1.2s cubic-bezier(0.22, 1, 0.36, 1),
          transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .js .reveal.is-visible {
        opacity: 1;
        filter: blur(0);
        transform: translate3d(0, 0, 0) scale(1);
      }

      .js .hero .reveal {
        transition:
          opacity 1.65s cubic-bezier(0.22, 1, 0.36, 1),
          filter 1.65s cubic-bezier(0.22, 1, 0.36, 1),
          transform 1.65s cubic-bezier(0.22, 1, 0.36, 1);
      }

      html.theme-transition,
      html.theme-transition *,
      html.theme-transition *::before,
      html.theme-transition *::after {
        transition:
          background-color 4.5s cubic-bezier(0.4, 0, 0.2, 1) !important,
          color 3s ease !important,
          border-color 3s ease !important,
          box-shadow 3s ease !important,
          filter 4.5s ease !important,
          opacity 3s ease !important,
          transform 3s ease !important;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav page-shell" aria-label="Primary navigation">
        <a class="wordmark" href="#home" aria-label="Maciej Karczmarz home">
          <span class="wordmark-mark">MK</span>
        </a>

        <div class="nav-panel" id="nav-panel">
          <div class="nav-links">
            <a class="nav-link" href="#about" data-i18n="nav.about">About</a>
            <a class="nav-link" href="#stack" data-i18n="nav.stack">Stack</a>
            <a class="nav-link" href="#projects" data-i18n="nav.projects"
              >Projects</a
            >
            <a class="nav-link" href="#experience" data-i18n="nav.dossier"
              >Documents</a
            >
            <a class="nav-link" href="#contact" data-i18n="nav.contact"
              >Contact</a
            >
          </div>
        </div>

        <div class="nav-actions">
          <div class="lang-switcher" aria-label="Language">
            <button class="lang-option" type="button" data-lang="pl">PL</button>
            <button class="lang-option" type="button" data-lang="en">EN</button>
            <button class="lang-option" type="button" data-lang="de">DE</button>
          </div>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
          >
            <svg
              class="theme-icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </button>
          <a
            class="nav-cta"
            href="/cv-english.pdf"
            download
            data-doc="cv"
            data-i18n="nav.cv">View CV</a
          >
          <button
            class="menu-toggle"
            type="button"
            aria-controls="nav-panel"
            aria-expanded="false"
            aria-label="Toggle navigation menu"
          >
            <span class="menu-toggle-lines" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="menu-toggle-label">Menu</span>
          </button>
        </div>
      </nav>
    </header>

    <main id="home">
      <section class="hero" id="hero" aria-labelledby="hero-title">
        <div class="hero-bg" aria-hidden="true">
          <div class="hero-mesh">
            <div class="hero-blob-wrap">
              <div class="hero-blob-shift">
                <div class="hero-blob"></div>
              </div>
            </div>
