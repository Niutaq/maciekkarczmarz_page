<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Maciej Karczmarz - junior DevOps and cloud engineer portfolio focused on Go, AWS, DigitalOcean, automation, FinOps, and runtime-aware technical work."
    />
    <meta name="theme-color" content="#141312" />
    <title>Maciej Karczmarz | Junior DevOps / Cloud Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const storedTheme = localStorage.getItem("portfolio-theme-mode");
        const theme =
          storedTheme ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        document.documentElement.dataset.theme = theme;
        document.documentElement.lang =
          localStorage.getItem("portfolio-language") || "en";
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
    <style is:inline>
      :root {
        --surface: #141312;
        --surface-dim: #141312;
        --surface-bright: #3b3937;
        --surface-container-lowest: #0f0e0d;
        --surface-container-low: #1d1b1a;
        --surface-container: #211f1e;
        --surface-container-high: #2b2a28;
        --surface-container-highest: #363433;
        --on-surface: #e6e1df;
        --on-surface-variant: #d8c2b2;
        --inverse-surface: #e6e1df;
        --inverse-on-surface: #32302f;
        --outline: #a18d7f;
        --outline-variant: #534438;
        --surface-tint: #ffb779;
        --primary: #ffb779;
        --on-primary: #4c2700;
        --primary-container: #cd7f32;
        --on-primary-container: #432200;
        --inverse-primary: #8e4e00;
        --secondary: #ffb86e;
        --on-secondary: #492900;
        --secondary-container: #9e5e00;
        --on-secondary-container: #ffeddf;
        --tertiary: #ffb68c;
        --on-tertiary: #532200;
        --tertiary-container: #d17c46;
        --on-tertiary-container: #491e00;
        --error: #ffb4ab;
        --on-error: #690005;
        --error-container: #93000a;
        --on-error-container: #ffdad6;
        --background: #141312;
        --on-background: #e6e1df;
        --surface-variant: #363433;

        --font-display: "Sora", sans-serif;
        --font-body: "Sora", sans-serif;
        --font-mono: "JetBrains Mono", monospace;

        --display-lg: clamp(2rem, 1.4rem + 2.6vw, 3rem);
        --headline-md: 1.5rem;
        --body-lg: 1.125rem;
        --body-md: 1rem;
        --code-sm: 0.875rem;
        --label-caps: 0.75rem;

        --radius-sm: 0.125rem;
        --radius-default: 0.25rem;
        --radius-md: 0.375rem;
        --radius-lg: 0.5rem;
        --radius-xl: 0.75rem;
        --radius-full: 9999px;

        --space-unit: 8px;
        --gutter: 24px;
        --margin-mobile: 16px;
        --margin-desktop: 64px;
        --max-width: 1440px;

        --glow-bronze: 0 0 24px rgba(205, 127, 50, 0.15);
        --glow-amber: 0 0 18px rgba(255, 184, 110, 0.18);
        --border-subtle: 1px solid var(--outline-variant);
        --border-active: 1px solid var(--primary-container);
        --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);

        --page-padding: 16px;
        --section-gap: 80px;
        --nav-height: 72px;
      }

      html[data-theme="light"] {
        --surface: #faf9f8;
        --surface-dim: #f3f1f0;
        --surface-bright: #ffffff;
        --surface-container-lowest: #ffffff;
        --surface-container-low: #f5f4f2;
        --surface-container: #efedeb;
        --surface-container-high: #e8e6e3;
        --surface-container-highest: #e2dfdc;
        --on-surface: #1d1b1a;
        --on-surface-variant: #494644;
        --inverse-surface: #32302f;
        --inverse-on-surface: #f5f4f2;
        --outline: #7b7673;
        --outline-variant: #cbc6c2;
        --surface-tint: #c46b00;
        --primary: #c46b00;
        --on-primary: #ffffff;
        --primary-container: #ffdfba;
        --on-primary-container: #3d1c00;
        --inverse-primary: #ffb779;
        --secondary: #8a4f09;
        --on-secondary: #ffffff;
        --secondary-container: #c67623;
        --on-secondary-container: #2c1600;
        --tertiary: #8f4c23;
        --on-tertiary: #ffffff;
        --tertiary-container: #d17c46;
        --on-tertiary-container: #321200;
        --background: #faf9f8;
        --on-background: #1d1b1a;
        --surface-variant: #e8e6e3;
        --glow-bronze: 0 0 24px rgba(196, 107, 0, 0.08);
        --glow-amber: 0 0 18px rgba(196, 107, 0, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--background);
      }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--on-surface);
        background:
          radial-gradient(
            circle at 78% 8%,
            rgba(205, 127, 50, 0.13),
            transparent 320px
          ),
          radial-gradient(
            circle at 16% 40%,
            rgba(255, 183, 121, 0.08),
            transparent 360px
          ),
          linear-gradient(
            180deg,
            var(--surface-container-lowest),
            var(--surface) 520px,
            var(--surface)
          );
        font-family: var(--font-body);
        font-size: var(--body-md);
        line-height: 1.6;
        text-rendering: geometricprecision;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background:
          linear-gradient(rgba(161, 141, 127, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(161, 141, 127, 0.03) 1px, transparent 1px);
        background-size: 32px 32px;
        mask-image: linear-gradient(
          to bottom,
          black 0%,
          black 54%,
          transparent 100%
        );
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          linear-gradient(
            90deg,
            rgba(255, 183, 121, 0.04),
            transparent 16%,
            transparent 84%,
            rgba(255, 183, 121, 0.04)
          ),
          linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 18%);
      }

      html[data-theme="light"] .stack-plate,
      html[data-theme="light"] .iso-node {
        background: var(--surface-container-high);
      }

      html[data-theme="light"] .chip {
        background: rgba(196, 107, 0, 0.08);
      }

      html[data-theme="light"] .project-media {
        background: var(--surface-container);
      }

      html[data-theme="light"] .iso-grid {
        background:
          linear-gradient(rgba(196, 107, 0, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(196, 107, 0, 0.04) 1px, transparent 1px),
          var(--surface-container-lowest);
      }

      html[data-theme="light"] .button-primary {
        color: #1d1b1a !important; /* Extremely dark color for readability */
        font-weight: 700;
      }
      html[data-theme="light"] .button-primary-old {
        color: var(--on-primary-container);
        border-color: var(--outline-variant);
      }

      html[data-theme="light"] .button-secondary {
        background: var(--surface-container);
      }

      html[data-theme="light"] .wordmark-mark {
        background: var(--surface-bright);
        border-color: var(--outline-variant);
        color: var(--primary);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      html[data-theme="light"] body {
        background:
          radial-gradient(
            circle at 78% 8%,
            rgba(196, 107, 0, 0.06),
            transparent 400px
          ),
          radial-gradient(
            circle at 14% 42%,
            rgba(196, 107, 0, 0.04),
            transparent 400px
          ),
          linear-gradient(
            180deg,
            var(--surface-container-lowest),
            var(--surface) 560px,
            var(--surface)
          );
      }

      html[data-theme="light"] body::before {
        background:
          linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
      }

      html[data-theme="light"] body::after {
        background:
          linear-gradient(
            90deg,
            rgba(196, 107, 0, 0.03),
            transparent 16%,
            transparent 84%,
            rgba(196, 107, 0, 0.03)
          ),
          linear-gradient(180deg, rgba(255, 255, 255, 0.8), transparent 24%);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      button {
        border: 0;
        cursor: pointer;
      }

      :focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 4px;
      }

      .page-shell {
        width: min(100% - (var(--page-padding) * 2), var(--max-width));
        margin-inline: auto;
      }

      .section {
        position: relative;
        padding-block: var(--section-gap);
        scroll-margin-top: calc(var(--nav-height) + 24px);
      }

      .section-header {
        display: grid;
        gap: 16px;
        max-width: 880px;
        margin-bottom: 40px;
      }

      .eyebrow,
      .section-kicker,
      .meta-label,
      .chip,
      .button,
      .nav-link,
      .nav-cta,
      .mono {
        font-family: var(--font-mono);
      }

      .eyebrow {
        margin: 0;
        color: var(--primary);
        font-size: var(--label-caps);
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-block: 0;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        color: var(--on-surface);
        line-height: 1.05;
        letter-spacing: 0;
      }

      h1 {
        max-width: 720px;
        font-size: 3rem;
        font-weight: 800;
      }

      h2 {
        font-size: 2rem;
        font-weight: 700;
      }

      h3 {
        font-size: var(--headline-md);
        font-weight: 650;
      }

      .lead {
        color: var(--on-surface-variant);
        font-size: 1.0625rem;
        line-height: 1.75;
      }

      .muted {
        color: var(--on-surface-variant);
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--outline-variant);
        background: rgba(20, 19, 18, 0.91);
        backdrop-filter: blur(18px);
      }

      html[data-theme="light"] .site-header {
        background: rgba(250, 249, 248, 0.92);
        border-bottom-color: rgba(0, 0, 0, 0.08);
      }

      .site-nav {
        min-height: var(--nav-height);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .wordmark {
        display: inline-flex;
        min-width: 48px;
        min-height: 48px;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-weight: 700;
      }

      .wordmark-mark {
        display: grid;
        width: 40px;
        height: 40px;
        place-items: center;
        border: var(--border-subtle);
        border-radius: var(--radius-default);
        color: var(--primary);
        background:
          linear-gradient(
            135deg,
            rgba(205, 127, 50, 0.18),
            rgba(29, 27, 26, 0.72)
          ),
          var(--surface-container-low);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          var(--glow-bronze);
      }

      .wordmark-text {
        display: none;
        color: var(--on-surface-variant);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .nav-panel {
        position: fixed;
        inset: var(--nav-height) 16px auto 16px;
        display: none;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background:
          linear-gradient(
            160deg,
            rgba(43, 42, 40, 0.98),
            rgba(20, 19, 18, 0.98)
          ),
          var(--surface-container);
        box-shadow: 0 24px 72px rgba(0, 0, 0, 0.28);
      }

      html[data-theme="light"] .nav-panel {
        background: var(--surface-container-lowest);
        box-shadow: 0 24px 72px rgba(0, 0, 0, 0.08);
      }

      .nav-panel.is-open {
        display: block;
      }

      .nav-links {
        display: grid;
        gap: 4px;
        padding: 12px;
      }

      .nav-link {
        position: relative;
        display: flex;
        min-height: 44px;
        align-items: center;
        border-radius: var(--radius-default);
        padding: 8px 12px;
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        transition:
          color 180ms var(--ease-premium),
          background-color 180ms var(--ease-premium);
      }

      .nav-link::after {
        content: "";
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 6px;
        height: 1px;
        transform: scaleX(0);
        transform-origin: left;
        background: var(--primary-container);
        transition: transform 180ms var(--ease-premium);
      }

      .nav-link:hover,
      .nav-link:focus-visible,
      .nav-link.is-active {
        color: var(--primary);
        background: rgba(255, 183, 121, 0.06);
      }

      .nav-link:hover::after,
      .nav-link.is-active::after {
        transform: scaleX(1);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .menu-toggle {
        display: inline-flex;
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid rgba(161, 141, 127, 0.34);
        border-radius: var(--radius-default);
        color: var(--on-surface);
        background: var(--surface-container-low);
      }

      .menu-toggle-lines {
        display: grid;
        width: 18px;
        gap: 4px;
      }

      .menu-toggle-lines span {
        height: 2px;
        border-radius: var(--radius-full);
        background: var(--primary);
      }

      .menu-toggle-lines span:nth-child(2) {
        width: 12px;
        justify-self: end;
      }

      .menu-toggle-label {
        display: none;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .nav-cta {
        display: none;
        min-height: 44px;
        align-items: center;
        border: 1px solid rgba(205, 127, 50, 0.72);
        border-radius: var(--radius-default);
        padding: 10px 14px;
        color: var(--primary);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        transition:
          background-color 180ms var(--ease-premium),
          box-shadow 180ms var(--ease-premium),
          transform 180ms var(--ease-premium);
      }

      .nav-cta:hover {
        transform: translateY(-1px);
        background: rgba(205, 127, 50, 0.12);
        box-shadow: var(--glow-bronze);
      }

      .theme-toggle,
      .lang-option {
        display: inline-flex;
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(161, 141, 127, 0.34);
        border-radius: var(--radius-default);
        color: var(--on-surface-variant);
        background: var(--surface-container-low);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        transition:
          border-color 180ms var(--ease-premium),
          color 180ms var(--ease-premium),
          background-color 180ms var(--ease-premium),
          transform 180ms var(--ease-premium);
      }

      .theme-toggle:hover,
      .lang-option:hover,
      .lang-option.is-active {
        border-color: var(--primary-container);
        color: var(--primary);
        background: rgba(205, 127, 50, 0.1);
      }

      .theme-toggle:hover,
      .lang-option:hover {
        transform: translateY(-1px);
      }

      .lang-switcher {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .theme-toggle svg {
        width: 17px;
        height: 17px;
        stroke-width: 2;
      }

      .hero {
        --px: 0;
        --py: 0;
        position: relative;
        min-height: calc(100svh - var(--nav-height));
        display: grid;
        align-items: center;
        padding-block: 48px 72px;
        overflow: hidden;
        perspective: 1100px;
      }

      .hero-layout {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 40px;
      }

      .hero-copy {
        display: grid;
        gap: 24px;
        max-width: 760px;
      }

      .hero-copy .lead {
        max-width: 680px;
      }

      .role-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .role-strip span {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid rgba(205, 127, 50, 0.38);
        border-radius: var(--radius-default);
        padding: 6px 10px;
        color: var(--primary);
        background: rgba(205, 127, 50, 0.08);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 650;
        text-transform: uppercase;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 8px;
      }

      .button {
        position: relative;
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: var(--radius-default);
        padding: 12px 16px;
        font-size: 0.8125rem;
        font-weight: 750;
        line-height: 1;
        text-transform: uppercase;
        transition:
          transform 180ms var(--ease-premium),
          border-color 180ms var(--ease-premium),
          color 180ms var(--ease-premium),
          background-color 180ms var(--ease-premium),
          box-shadow 180ms var(--ease-premium);
      }

      .button svg {
        width: 18px;
        height: 18px;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .button-primary {
        border: 1px solid rgba(255, 183, 121, 0.38);
        color: var(--on-primary);
        background:
          linear-gradient(
            180deg,
            rgba(255, 183, 121, 0.24),
            rgba(255, 255, 255, 0)
          ),
          var(--primary-container);
        box-shadow:
          var(--glow-bronze),
          inset 0 1px 0 rgba(255, 237, 223, 0.28);
      }

      .button-secondary {
        border: 2px solid rgba(205, 127, 50, 0.86);
        color: var(--primary);
        background: rgba(15, 14, 13, 0.42);
      }

      .button-ghost {
        border: 1px solid transparent;
        color: var(--on-surface-variant);
        background: transparent;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button:active {
        transform: translateY(1px);
      }

      .button-primary:hover {
        box-shadow:
          0 0 34px rgba(205, 127, 50, 0.23),
          inset 0 1px 0 rgba(255, 237, 223, 0.32);
      }

      .button-secondary:hover,
      .button-ghost:hover {
        border-color: var(--primary-container);
        color: var(--primary);
        background: rgba(205, 127, 50, 0.09);
        box-shadow: var(--glow-bronze);
      }

      .hero-visual {
        position: relative;
        transform-style: preserve-3d;
      }

      .ops-console {
        position: relative;
        overflow: hidden;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background:
          linear-gradient(
            140deg,
            rgba(43, 42, 40, 0.94),
            rgba(29, 27, 26, 0.94) 42%,
            rgba(15, 14, 13, 0.94)
          ),
          var(--surface-container-low);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.06),
          inset 0 -1px 0 rgba(0, 0, 0, 0.36);
      }

      html[data-theme="light"] .ops-console {
        background: var(--surface-container-low);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 1),
          inset 0 -1px 0 rgba(0, 0, 0, 0.08);
      }

      .ops-console::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(
            90deg,
            transparent,
            rgba(255, 183, 121, 0.08),
            transparent
          ),
          linear-gradient(rgba(255, 255, 255, 0.035), transparent 18%);
        opacity: 0.8;
      }

      .console-head {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid var(--outline-variant);
        padding: 16px;
      }

      .console-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: var(--radius-full);
        background: var(--primary);
        box-shadow: 0 0 12px rgba(255, 183, 121, 0.8);
      }

      .console-id {
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
      }

      .console-body {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 16px;
        padding: 16px;
      }

      .console-grid {
        display: grid;
        gap: 12px;
      }

      .metric {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px 12px;
        align-items: center;
        border: 1px solid var(--outline-variant);
        border-radius: var(--radius-default);
        padding: 12px;
        background: rgba(15, 14, 13, 0.42);
      }

      html[data-theme="light"] .metric,
      html[data-theme="light"] .terminal,
      html[data-theme="light"] .field input,
      html[data-theme="light"] .field textarea {
        background: var(--surface-bright);
      }

      .metric span:first-child {
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .metric strong {
        color: var(--on-surface);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 650;
        text-align: right;
      }

      .metric-bar {
        grid-column: 1 / -1;
        height: 8px;
        overflow: hidden;
        border-radius: var(--radius-full);
        background: var(--surface-container-highest);
      }

      .metric-bar i {
        display: block;
        width: var(--fill);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          var(--primary-container),
          var(--secondary)
        );
        box-shadow: var(--glow-amber);
      }

      .terminal {
        border: 1px solid var(--outline-variant);
        border-radius: var(--radius-default);
        background: rgba(15, 14, 13, 0.76);
        padding: 12px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
      }

      html[data-theme="light"] .terminal-line {
        color: var(--on-surface);
      }

      .terminal-line {
        display: flex;
        gap: 10px;
        min-height: 24px;
        align-items: flex-start;
        color: var(--on-surface);
        overflow-wrap: anywhere;
      }

      .terminal-line span {
        color: var(--primary);
      }

      .infra-stack {
        position: relative;
        min-height: 240px;
        margin-top: 8px;
      }

      .infra-stack::before,
      .infra-stack::after {
        content: "";
        position: absolute;
        left: 26%;
        right: 22%;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 183, 121, 0.52),
          transparent
        );
        box-shadow: var(--glow-amber);
      }

      .infra-stack::before {
        top: 84px;
      }

      .infra-stack::after {
        top: 156px;
      }

      .stack-plate {
        position: absolute;
        display: grid;
        min-height: 88px;
        align-content: center;
        border: 1px solid rgba(205, 127, 50, 0.34);
        border-radius: var(--radius-default);
        padding: 16px;
        background:
          linear-gradient(
            145deg,
            rgba(205, 127, 50, 0.18),
            rgba(29, 27, 26, 0.92) 44%,
            rgba(15, 14, 13, 0.96)
          ),
          var(--surface-container);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.07),
          0 0 26px rgba(205, 127, 50, 0.08);
        transform: translate3d(0, 0, 0);
      }

      .stack-plate::before,
      .stack-plate::after {
        content: "";
        position: absolute;
        pointer-events: none;
        background: rgba(205, 127, 50, 0.18);
      }

      .stack-plate::before {
        left: 10px;
        right: 10px;
        top: 8px;
        height: 1px;
      }

      .stack-plate::after {
        top: 10px;
        bottom: 10px;
        right: 8px;
        width: 1px;
      }

      .stack-plate b {
        color: var(--on-surface);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 700;
      }

      .stack-plate span {
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        text-transform: uppercase;
      }

      .plate-a {
        top: 4px;
        left: 20px;
        width: 64%;
      }

      .plate-b {
        top: 72px;
        right: 8px;
        width: 64%;
      }

      .plate-c {
        top: 144px;
        left: 48px;
        width: 64%;
      }

      .section-grid {
        display: grid;
        gap: 24px;
      }

      .value-grid {
        display: grid;
        gap: 16px;
      }

      .card,
      .project-card,
      .timeline-card,
      .contact-panel,
      .stack-map,
      .skill-card {
        position: relative;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background:
          linear-gradient(
            145deg,
            rgba(29, 27, 26, 0.98),
            rgba(20, 19, 18, 0.98)
          ),
          var(--surface-container-low);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
      }

      html[data-theme="light"] .card,
      html[data-theme="light"] .project-card,
      html[data-theme="light"] .timeline-card,
      html[data-theme="light"] .contact-panel,
      html[data-theme="light"] .stack-map,
      html[data-theme="light"] .skill-card {
        background: var(--surface-container-low);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 1),
          0 0 0 1px rgba(0, 0, 0, 0.05);
      }

      .card::before,
      .project-card::before,
      .timeline-card::before,
      .skill-card::before,
      .contact-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: inherit;
        background:
          linear-gradient(90deg, rgba(255, 255, 255, 0.045), transparent 28%),
          linear-gradient(180deg, rgba(255, 183, 121, 0.04), transparent 34%);
      }

      .corner-cuts {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .corner-cuts::before,
      .corner-cuts::after {
        content: "";
        position: absolute;
        width: 24px;
        height: 24px;
        border-color: rgba(255, 183, 121, 0.54);
      }

      .corner-cuts::before {
        top: 12px;
        left: 12px;
        border-top: 1px solid;
        border-left: 1px solid;
      }

      .corner-cuts::after {
        right: 12px;
        bottom: 12px;
        border-right: 1px solid;
        border-bottom: 1px solid;
      }

      .card {
        overflow: hidden;
        padding: 24px;
      }

      .card h3 {
        margin-top: 16px;
      }

      .card p {
        margin-top: 12px;
        color: var(--on-surface-variant);
      }

      .card-index {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
      }

      .about-matrix {
        display: grid;
        gap: 16px;
      }

      .signal-panel {
        overflow: hidden;
        border: var(--border-subtle);
        border-radius: var(--radius-lg);
        background: var(--surface-container-lowest);
      }

      .signal-row {
        display: grid;
        gap: 8px;
        border-top: 1px solid var(--outline-variant);
        padding: 16px;
      }

      .signal-row:first-child {
        border-top: 0;
      }

      .signal-row dt {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .signal-row dd {
        margin: 0;
        color: var(--on-surface-variant);
      }

      .skills-layout {
        display: grid;
        gap: 24px;
      }

      .skills-grid {
        display: grid;
        gap: 16px;
      }

      .skill-card {
        overflow: hidden;
        padding: 20px;
      }

      .skill-topline {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .skill-topline h3 {
        font-size: 1rem;
      }

      .skill-code {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
      }

      .skill-list {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .chip {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid rgba(205, 127, 50, 0.38);
        border-radius: var(--radius-default);
        padding: 6px 10px;
        color: var(--primary);
        background:
          linear-gradient(
            180deg,
            rgba(205, 127, 50, 0.14),
            rgba(15, 14, 13, 0.4)
          ),
          var(--surface-container-low);
        font-size: 0.75rem;
        font-weight: 650;
        text-transform: uppercase;
      }

      .capability {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 8px;
        margin-top: 16px;
      }

      .capability-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .progress {
        height: 10px;
        overflow: hidden;
        border-radius: var(--radius-full);
        background: var(--surface-container-highest);
      }

      .progress i {
        display: block;
        width: var(--value);
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          var(--primary-container),
          var(--secondary)
        );
        box-shadow: var(--glow-amber);
      }

      .stack-map {
        overflow: hidden;
        min-height: 520px;
        padding: 24px;
      }

      .stack-map h3 {
        position: relative;
        z-index: 1;
      }

      .stack-map p {
        position: relative;
        z-index: 1;
        margin-top: 12px;
        color: var(--on-surface-variant);
      }

      .iso-stage {
        position: relative;
        min-height: 360px;
        margin-top: 24px;
        perspective: 900px;
      }

      .iso-grid {
        position: absolute;
        inset: 28px 0 0 0;
        transform: rotateX(54deg) rotateZ(-24deg);
        transform-origin: center;
        border: 1px solid var(--outline-variant);
        background:
          linear-gradient(rgba(255, 183, 121, 0.08) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(255, 183, 121, 0.08) 1px,
            transparent 1px
          ),
          rgba(15, 14, 13, 0.4);
        background-size: 32px 32px;
      }

      .iso-node {
        position: absolute;
        display: grid;
        min-width: 136px;
        min-height: 72px;
        align-content: center;
        border: 1px solid rgba(205, 127, 50, 0.52);
        border-radius: var(--radius-default);
        padding: 12px;
        background:
          linear-gradient(
            145deg,
            rgba(205, 127, 50, 0.18),
            rgba(29, 27, 26, 0.94)
          ),
          var(--surface-container);
        box-shadow:
          0 0 20px rgba(205, 127, 50, 0.1),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        transform: translateZ(0);
      }

      .iso-node span {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .iso-node b {
        color: var(--on-surface);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }

      .node-1 {
        top: 24px;
        left: 0;
      }

      .node-2 {
        top: 120px;
        right: 8px;
      }

      .node-3 {
        bottom: 48px;
        left: 24px;
      }

      .node-4 {
        bottom: 0;
        right: 32px;
      }

      .iso-link {
        position: absolute;
        height: 1px;
        background: linear-gradient(
          90deg,
          rgba(255, 183, 121, 0),
          rgba(255, 183, 121, 0.62),
          rgba(255, 183, 121, 0)
        );
        transform-origin: left center;
        box-shadow: var(--glow-amber);
      }

      .link-1 {
        top: 96px;
        left: 120px;
        width: 44%;
        transform: rotate(17deg);
      }

      .link-2 {
        top: 184px;
        left: 28%;
        width: 44%;
        transform: rotate(-23deg);
      }

      .link-3 {
        bottom: 86px;
        left: 164px;
        width: 38%;
        transform: rotate(10deg);
      }

      .project-grid {
        position: relative;
        display: grid;
        gap: 24px;
      }

      .project-grid::before {
        content: "";
        position: absolute;
        top: 16px;
        bottom: 16px;
        left: 10px;
        width: 1px;
        background: linear-gradient(
          180deg,
          transparent,
          rgba(255, 183, 121, 0.46),
          transparent
        );
      }

      .project-card {
        --rx: 0deg;
        --ry: 0deg;
        --mx: 50%;
        --my: 50%;
        overflow: hidden;
        display: grid;
        isolation: isolate;
        margin-left: 20px;
        transition:
          transform 220ms var(--ease-premium),
          border-color 220ms var(--ease-premium),
          box-shadow 220ms var(--ease-premium);
        transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry))
          translateY(0);
      }

      .project-card::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(
          circle at var(--mx) var(--my),
          rgba(255, 183, 121, 0.16),
          transparent 34%
        );
        transition: opacity 180ms var(--ease-premium);
      }

      .project-card:hover {
        border-color: var(--primary-container);
        box-shadow:
          0 0 28px rgba(205, 127, 50, 0.14),
          inset 0 1px 0 rgba(255, 255, 255, 0.07);
      }

      .project-card:hover::after {
        opacity: 1;
      }

      .project-media {
        position: relative;
        overflow: hidden;
        min-height: 224px;
        border-bottom: 1px solid var(--outline-variant);
        background:
          linear-gradient(
            135deg,
            rgba(255, 183, 121, 0.07),
            rgba(15, 14, 13, 0.1)
          ),
          var(--surface-container-lowest);
      }

      .project-media img {
        width: 100%;
        height: 100%;
        min-height: 224px;
        object-fit: contain;
        padding: 24px;
        opacity: 0.88;
        filter: saturate(0.85) contrast(1.08);
        transition:
          transform 600ms var(--ease-premium),
          opacity 220ms var(--ease-premium);
      }

      .project-card:hover .project-media img {
        transform: scale(1.035);
        opacity: 1;
      }

      .project-media::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(180deg, transparent, rgba(15, 14, 13, 0.28)),
          linear-gradient(90deg, rgba(205, 127, 50, 0.12), transparent 42%);
      }

      .project-content {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 20px;
        padding: 24px;
      }

      .project-top {
        display: grid;
        gap: 8px;
      }

      .project-top h3 {
        font-size: 1.5rem;
      }

      .project-summary {
        color: var(--on-surface-variant);
      }

      .project-facts {
        display: grid;
        gap: 12px;
      }

      .fact {
        border-left: 2px solid rgba(205, 127, 50, 0.64);
        padding-left: 12px;
      }

      .fact dt {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .fact dd {
        margin: 4px 0 0;
        color: var(--on-surface);
        font-size: 0.9375rem;
      }

      .project-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-top: 1px solid var(--outline-variant);
        padding-top: 20px;
      }

      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .project-link {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .project-link svg {
        width: 16px;
        height: 16px;
        transition: transform 180ms var(--ease-premium);
      }

      .project-link:hover svg {
        transform: translate(2px, -2px);
      }

      .dossier-layout {
        display: grid;
        gap: 24px;
      }

      .timeline-card {
        overflow: hidden;
        padding: 24px;
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .timeline-card p:last-of-type {
        flex-grow: 1;
      }

      .timeline-card + .timeline-card {
        margin-top: 16px;
      }

      .timeline-date {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid rgba(205, 127, 50, 0.38);
        border-radius: var(--radius-default);
        padding: 6px 10px;
        color: var(--primary);
        background: rgba(205, 127, 50, 0.08);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .timeline-card h3 {
        margin-top: 16px;
      }

      .timeline-company {
        margin-top: 8px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }

      .timeline-card p {
        margin-top: 16px;
        color: var(--on-surface-variant);
      }

      .timeline-card .chip-row,
      .timeline-card .button {
        margin-top: 16px;
      }

      .contact-panel {
        overflow: hidden;
        display: grid;
        gap: 32px;
        padding: 24px;
      }

      .contact-copy {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 16px;
      }

      .contact-copy h2 {
        max-width: 680px;
      }

      .contact-links {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 8px;
        margin-top: 8px;
      }

      .contact-link {
        display: grid;
        gap: 4px;
        border-top: 1px solid var(--outline-variant);
        padding-block: 16px;
      }

      .contact-link span {
        color: var(--primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      .contact-link strong {
        color: var(--on-surface);
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      .contact-form {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 24px;
      }

      .field {
        position: relative;
      }

      .field input,
      .field textarea {
        width: 100%;
        border: 0;
        border-bottom: 2px solid var(--outline-variant);
        border-radius: var(--radius-default) var(--radius-default) 0 0;
        color: var(--on-surface);
        background: rgba(15, 14, 13, 0.72);
        padding: 24px 12px 10px;
        outline: 0;
        transition:
          border-color 180ms var(--ease-premium),
          background-color 180ms var(--ease-premium),
          box-shadow 180ms var(--ease-premium);
      }

      .field textarea {
        min-height: 136px;
        resize: vertical;
      }

      .field label {
        position: absolute;
        left: 12px;
        top: 18px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        transform-origin: left top;
        transition:
          transform 180ms var(--ease-premium),
          color 180ms var(--ease-premium);
      }

      .field input:focus,
      .field textarea:focus {
        border-bottom-color: var(--primary);
        background: rgba(29, 27, 26, 0.9);
        box-shadow: 0 8px 20px rgba(205, 127, 50, 0.08);
      }

      html[data-theme="light"] .field input:focus,
      html[data-theme="light"] .field textarea:focus {
        background: rgba(255, 250, 244, 0.94);
      }

      .field input:focus + label,
      .field input:not(:placeholder-shown) + label,
      .field textarea:focus + label,
      .field textarea:not(:placeholder-shown) + label {
        color: var(--primary);
        transform: translateY(-12px) scale(0.82);
      }

      .site-footer {
        border-top: 1px solid var(--outline-variant);
        padding-block: 32px;
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .footer-links a {
        min-height: 32px;
        color: var(--on-surface-variant);
      }

      .footer-links a:hover {
        color: var(--primary);
      }

      .reveal {
        opacity: 1;
        transform: none;
      }

      .js .reveal {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        transition:
          opacity 520ms var(--ease-premium),
          transform 520ms var(--ease-premium);
      }

      .js .reveal.is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      @media (min-width: 600px) {
        :root {
          --page-padding: 24px;
          --section-gap: 96px;
        }

        h1 {
          font-size: 4rem;
        }

        h2 {
          font-size: 2.5rem;
        }

        .wordmark-text,
        .menu-toggle-label,
        .nav-cta {
          display: inline-flex;
        }

        .console-grid,
        .value-grid,
        .skills-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .project-content,
        .timeline-card,
        .contact-panel,
        .card,
        .skill-card,
        .stack-map {
          padding: 32px;
        }
      }

      @media (max-width: 599px) {
        .lang-option {
          min-width: 36px;
          min-height: 40px;
        }

        .project-media {
          max-height: 280px;
        }
      }

      @media (min-width: 960px) {
        :root {
          --page-padding: 64px;
          --section-gap: 120px;
        }

        h1 {
          font-size: 5rem;
        }

        h2 {
          font-size: 3rem;
        }

        .menu-toggle {
          display: none;
        }

        .nav-panel {
          position: static;
          display: block;
          border: 0;
          background: transparent;
          box-shadow: none;
        }

        .nav-links {
          display: flex;
          align-items: center;
          gap: 4px;
          padding: 0;
        }

        .nav-link {
          padding-inline: 10px;
        }

        .hero-layout {
          grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
          align-items: center;
        }

        .hero-visual {
          transform: translate3d(
            calc(var(--px) * -10px),
            calc(var(--py) * -8px),
            0
          );
        }

        .about-matrix,
        .skills-layout,
        .dossier-layout {
          grid-template-columns: 0.82fr 1.18fr;
          align-items: start;
        }

        .dossier-layout {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          align-items: start;
        }

        .project-card {
          grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        }

        .project-media {
          min-height: 100%;
          border-right: 1px solid var(--outline-variant);
          border-bottom: 0;
        }

        .project-media img {
          height: 100%;
          min-height: 420px;
        }

        .project-facts {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fact-wide {
          grid-column: 1 / -1;
        }

        .footer-inner {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }
      }

      @media (min-width: 1200px) {
        h1 {
          font-size: 5.75rem;
        }

        .project-grid {
          gap: 32px;
        }
      }

      @media (hover: hover) and (pointer: fine) {
        .project-card:hover {
          transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry))
            translateY(-4px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.001ms !important;
        }

        .js .reveal {
          opacity: 1;
          transform: none;
        }
        .hero-visual,
        .project-card {
          transform: none !important;
        }
      }

      .map-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
        border-bottom: 1px solid rgba(83, 68, 56, 0.72);
        padding-bottom: 12px;
      }

      html[data-theme="light"] .map-tabs {
        border-bottom-color: var(--outline-variant);
      }

      .map-tab {
        background: transparent;
        border: none;
        color: var(--on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 8px 16px;
        border-radius: var(--radius-default);
        cursor: pointer;
        transition: all 180ms var(--ease-premium);
      }

      .map-tab:hover {
        color: var(--primary);
        background: rgba(205, 127, 50, 0.08);
      }

      .map-tab.active {
        color: var(--primary);
        background: rgba(205, 127, 50, 0.12);
        box-shadow: inset 0 1px 0 rgba(255, 237, 223, 0.1);
      }

      html[data-theme="light"] .map-tab.active {
        background: rgba(196, 107, 0, 0.08);
        box-shadow: none;
      }

      .map-panel {
        display: none;
      }

      .map-panel.active {
        display: block;
      }

      html.theme-transition,
      html.theme-transition *,
      html.theme-transition *::before,
      html.theme-transition *::after {
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
    </style>
